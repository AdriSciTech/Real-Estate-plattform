# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (Required for image uploads)
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=propertyphotos
R2_CUSTOM_DOMAIN=img.yourdomain.com
CLOUDFLARE_MAIN_DOMAIN=yourdomain.com

# Google Maps (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Stripe (If using payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Application URLs (for local development)
NEXT_PUBLIC_LISTINGS_URL=http://localhost:3000
NEXT_PUBLIC_RESERVATIONS_URL=http://localhost:3001
NEXT_PUBLIC_UPLOAD_URL=http://localhost:3002
