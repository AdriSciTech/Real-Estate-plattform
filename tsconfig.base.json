{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "baseUrl": ".",
    "paths": {
      "@rental/types": ["packages/types/src"],
      "@rental/types/*": ["packages/types/src/*"],
      "@rental/google-maps": ["packages/google-maps/src"],
      "@rental/google-maps/*": ["packages/google-maps/src/*"],
      "@rental/supabase": ["packages/supabase/src"],
      "@rental/supabase/*": ["packages/supabase/src/*"],
      "@rental/image-handling": ["packages/image-handling/src"],
      "@rental/image-handling/*": ["packages/image-handling/src/*"]
    },
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}